# Sonic 服务访问地址
SONIC_HOST=10.1.3.177
SONIC_WEB_PORT=3002
SONIC_API_PORT=8094

# 数据库与缓存
SONIC_MYSQL_PORT=3307
SONIC_REDIS_PORT=6380
SONIC_MYSQL_DATABASE=sonic
SONIC_MYSQL_USER=sonic
SONIC_MYSQL_PASSWORD=sonic_password_here
SONIC_MYSQL_ROOT_PASSWORD=sonic_root_password_here

# 镜像版本由运维确认后填写。这里不把镜像名写死，避免 Sonic 官方镜像拆分或命名变化导致平台代码跟着改。
SONIC_WEB_IMAGE=sonic-web-image:latest
SONIC_SERVER_IMAGE=sonic-server-image:latest

# 平台侧可使用：
# SONIC_API_BASE=http://10.1.3.177:5173/sonic-api
# SONIC_WEB_URL=http://10.1.3.177:5173/sonic-admin
# SONIC_API_PROXY_TARGET=http://127.0.0.1:8094
# SONIC_WEB_PROXY_TARGET=http://127.0.0.1:3002
