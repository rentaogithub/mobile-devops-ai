<?xml version='1.1' encoding='UTF-8'?>
<project>
  <actions/>
  <description>nn-ios local iPhone automatic quality job. Triggered by nn-ios-platform.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>SOURCE_JOB</name>
          <defaultValue>nn</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SOURCE_BUILD_NUMBER</name>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>BRANCH</name>
          <defaultValue>develop</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>COMMIT_HASH</name>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>APP_VERSION</name>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>PACKAGE_URL</name>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>ARCHIVE_URL</name>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>XCARCHIVE_PATH</name>
          <defaultValue></defaultValue>
          <description>打包机本地 .xcarchive 路径，用于从 Products/Applications 生成临时 IPA 进行真机安装。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>TEST_SUITE</name>
          <defaultValue>smoke</defaultValue>
          <description>质检套件：smoke、login、im、rtc、monkey、full。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>REQUESTED_TEST_SUITE</name>
          <defaultValue></defaultValue>
          <description>平台原始选择的质检套件。为空时使用 TEST_SUITE。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>RUN_MONKEY</name>
          <defaultValue>0</defaultValue>
          <description>设为 1 时执行 Monkey 随机测试。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>DEVICE_POOL</name>
          <defaultValue>ios-default</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>DEVICE_POOL_LABEL</name>
          <defaultValue>iOS default devices</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>DEVICE_UDID</name>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>DEVICE_CLOUD</name>
          <defaultValue>LocalMac</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>APP_BUNDLE_ID</name>
          <defaultValue>com.nndev.im</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>QUALITY_RUNNER</name>
          <defaultValue>local-ios-device</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>QA_RUNNER_MODE</name>
          <defaultValue>local-usb</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>WDA_URL</name>
          <defaultValue>http://10.1.3.177:8100</defaultValue>
          <description>Monkey 测试使用的 WebDriverAgent 地址。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>WDA_AUTO_START</name>
          <defaultValue>1</defaultValue>
          <description>Monkey 测试前自动启动 WebDriverAgent。1=启用，0=跳过。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>WDA_PROJECT_PATH</name>
          <defaultValue></defaultValue>
          <description>可选：WebDriverAgent.xcodeproj 路径。留空时自动查找 Sonic Agent / Appium 常见目录。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>MONKEY_EVENT_COUNT</name>
          <defaultValue>30</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>MONKEY_INTERVAL_SECONDS</name>
          <defaultValue>0.35</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>NN_IOS_PLATFORM_DIR</name>
          <defaultValue></defaultValue>
          <description>nn-ios-platform 在 Jenkins 打包机上的实际目录。平台触发质检时会自动传入，手动构建时可填写。</description>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SONIC_API_BASE</name>
          <defaultValue>http://10.1.3.177:5173/sonic-api</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SONIC_PROJECT_ID</name>
          <defaultValue>nn-ios</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SONIC_TEST_PLAN_ID</name>
          <defaultValue>smoke</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.PasswordParameterDefinition>
          <name>SONIC_TOKEN</name>
          <defaultValue></defaultValue>
        </hudson.model.PasswordParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>set -e
PLATFORM_DIR="${NN_IOS_PLATFORM_DIR:-}"
if [ -z "$PLATFORM_DIR" ] &amp;&amp; [ -n "${WORKSPACE:-}" ] &amp;&amp; [ -f "$WORKSPACE/scripts/sonic/ios-quality.sh" ]; then
  PLATFORM_DIR="$WORKSPACE"
fi
if [ -z "$PLATFORM_DIR" ] || [ ! -f "$PLATFORM_DIR/scripts/sonic/ios-quality.sh" ]; then
  echo "ERROR: NN_IOS_PLATFORM_DIR is not configured or invalid."
  echo "Expected file: \$NN_IOS_PLATFORM_DIR/scripts/sonic/ios-quality.sh"
  echo "When triggered by nn-ios-platform, this parameter is passed automatically."
  echo "For manual Jenkins builds, fill NN_IOS_PLATFORM_DIR with the platform project directory."
  exit 2
fi
cd "$PLATFORM_DIR"
bash scripts/sonic/ios-quality.sh</command>
    </hudson.tasks.Shell>
  </builders>
  <publishers>
    <hudson.tasks.junit.JUnitResultArchiver>
      <testResults>quality-results/**/*.xml</testResults>
      <keepLongStdio>true</keepLongStdio>
      <skipPublishingChecks>true</skipPublishingChecks>
      <checksName></checksName>
      <skipMarkingBuildUnstable>false</skipMarkingBuildUnstable>
      <skipOldReports>false</skipOldReports>
      <healthScaleFactor>1.0</healthScaleFactor>
      <allowEmptyResults>true</allowEmptyResults>
    </hudson.tasks.junit.JUnitResultArchiver>
    <hudson.tasks.ArtifactArchiver>
      <artifacts>quality-results/**</artifacts>
      <allowEmptyArchive>true</allowEmptyArchive>
      <onlyIfSuccessful>false</onlyIfSuccessful>
      <fingerprint>false</fingerprint>
      <defaultExcludes>true</defaultExcludes>
      <caseSensitive>true</caseSensitive>
      <followSymlinks>true</followSymlinks>
    </hudson.tasks.ArtifactArchiver>
  </publishers>
  <buildWrappers/>
</project>
