PORT=3000
# 数据存储路径（与项目目录同级）
# 可以使用相对路径 ../../nn-ios-platform-data 或绝对路径
UPLOAD_DIR=../../nn-ios-platform-data/uploads
DSYM_DIR=../../nn-ios-platform-data/dsyms
DB_PATH=../../nn-ios-platform-data/database.sqlite
MAX_FILE_SIZE=524288000
LOG_LEVEL=info
NODE_ENV=development

# Xcode 系统符号路径（可选，用于符号化系统库）
# 实际的系统符号在用户目录下
XCODE_SYMBOLS_PATH=~/Library/Developer/Xcode/iOS DeviceSupport

# 是否启用系统符号化（默认 false）
ENABLE_SYSTEM_SYMBOLICATION=true

# 通义千问 AI 分析配置
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
AI_ANALYSIS_TIMEOUT=30000

# 网站权限认证配置
# 普通用户无需登录，管理员需要登录
AUTH_ENABLED=true
ADMIN_PASSWORD=admin_password_here

# 定期清理配置
CLEANUP_INTERVAL_HOURS=1
CLEANUP_MAX_AGE_HOURS=24

# Git 仓库访问凭据（用于 Git 管理模块的分支操作）
GIT_USERNAME=
GIT_PASSWORD=

# Sentry 反向代理配置
SENTRY_PROXY_TARGET=http://172.31.2.239:9000
SENTRY_PUBLIC_URL=https://data.nn.com/sentry
SENTRY_DEFAULT_PATH=/organizations/sentry/projects/nn-ios/?project=6

# Sentry 自动登录配置
# 开启后，平台后端会代登录 Sentry 并维护会话 cookie，浏览器访问 /sentry 时无需手动登录
SENTRY_AUTO_LOGIN=false
SENTRY_LOGIN_USERNAME=
SENTRY_LOGIN_PASSWORD=

# Jenkins / CI-CD 配置
JENKINS_BASE_URL=http://10.1.3.177:8080
JENKINS_NN_JOB=nn
JENKINS_NN_QA_JOB=nn-auto-quality
JENKINS_NN_REPO_URL=http://git.leigod.top/nn_ios/nnios.git
JENKINS_USER=
JENKINS_TOKEN=

# Sonic 自动质检配置
SONIC_STACK_AUTO_START=true
SONIC_API_BASE=http://10.1.3.177:5173/sonic-api
SONIC_WEB_URL=http://10.1.3.177:5173/sonic-admin
SONIC_API_PROXY_TARGET=http://127.0.0.1:8094
SONIC_WEB_PROXY_TARGET=http://127.0.0.1:3002
SONIC_TOKEN=
SONIC_PROJECT_ID=
SONIC_TEST_PLAN_ID=
# 平台可配置 Sonic 设备池，value 会作为 DEVICE_POOL 传给 Jenkins 质检 Job，groupId 可在 nnios/ci/sonic_quality.sh 中映射 Sonic 设备组
SONIC_DEVICE_POOLS_JSON=[{"label":"iOS 默认设备池","value":"ios-default","groupId":"1","description":"默认可用 iOS 真机设备，适合日常冒烟质检。"},{"label":"iPhone 新系统池","value":"ios-latest","groupId":"2","description":"较新 iOS 系统设备，适合新系统兼容性检查。"},{"label":"iPhone 兼容性池","value":"ios-compat","groupId":"3","description":"覆盖较旧机型或系统版本，适合发布前兼容性回归。"}]

# Sonic Agent 本机拉起配置（可选）
# npm run dev / npm start 会尝试自动启动 Agent；未配置时不影响平台启动
SONIC_AGENT_AUTO_START=true
# 二选一：指定 Agent 目录，目录下存在 start.sh 或 sonic-agent*.jar
SONIC_AGENT_DIR=/Users/a1/工作/sonic-agent
# 或者直接指定启动命令，例如：cd /Users/a1/工作/sonic-agent && sh start.sh
SONIC_AGENT_CMD=
SONIC_AGENT_API_BASE=http://127.0.0.1:8094
