{
  "name": "ios-crash-symbolizer",
  "version": "1.0.0",
  "description": "iOS 崩溃日志符号化系统",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "ensure:native": "node scripts/ensure-native-deps.mjs",
    "start:sonic-stack": "bash scripts/start-sonic-stack.sh",
    "start:sonic-agent": "bash scripts/start-sonic-agent.sh",
    "start:sonic": "bash scripts/bootstrap-sonic.sh",
    "dev": "node scripts/run-with-supported-node.mjs dev:actual",
    "dev:actual": "npm run ensure:native && npm run start:sonic && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "node scripts/run-with-supported-node.mjs build:actual",
    "build:actual": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "node scripts/run-with-supported-node.mjs start:actual",
    "start:actual": "npm run ensure:native && npm run start:sonic && env UPLOAD_DIR=nn-ios-platform-data/uploads DSYM_DIR=nn-ios-platform-data/dsyms DB_PATH=nn-ios-platform-data/database.sqlite node --env-file=backend/.env backend/dist/index.js",
    "start:dev-backend": "node scripts/run-with-supported-node.mjs start:actual"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.60.0"
  }
}
